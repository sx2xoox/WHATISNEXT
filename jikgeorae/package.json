{
  "name": "jikgeorae-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && node dist-server/server.mjs",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "start": "node dist-server/server.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "three": "0.186.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
